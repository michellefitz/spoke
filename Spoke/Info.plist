	<string>Spoke turns what you say into tasks. Transcription can run on this iPhone without your voice leaving it.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict/>
